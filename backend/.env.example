# FinRelief Backend Environment Variables Example
# Copy this file to .env and fill in the values before running the backend.

# --------------------------
# AI & Security
# --------------------------
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (Generate a random string for production)
SECRET_KEY=super-secret-jwt-key-change-me-in-production

# Explicit allowed origins for CORS (comma separated if multiple, e.g., http://localhost:3000,https://my-frontend.com)
FRONTEND_URL=http://localhost:3000

# --------------------------
# Application Config
# --------------------------
# Model name to use for Gemini API
GEMINI_MODEL=gemini-2.5-flash

# Set to True for local development to enable detailed error tracebacks (disable in production)
DEBUG=True
